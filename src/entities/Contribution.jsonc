{
  // Supabase table: public.contributions
  // Members can submit their own contributions as pending; only admins can verify/reject.
  "id": "uuid",
  "member_id": "uuid references public.members.id",
  "amount": "number",
  "month": "1-12",
  "year": "number",
  "status": "paid | partial | outstanding",
  "payment_method": "manual | cash | bank | other",
  "verification_status": "pending | verified | rejected",
  "recorded_by": "uuid",
  "verified_by": "uuid | null",
  "verified_at": "ISO datetime | null",
  "recorded_at": "ISO datetime"
}
